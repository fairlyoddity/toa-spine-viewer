{
  "name": "toa-spine-exporter",
  "version": "1.0.0",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win zip",
    "build:linux": "electron-builder --linux AppImage",
    "build:all": "electron-builder -w zip -l AppImage"
  },

  "build": {
    "appId": "com.toa.spine.exporter",
    "productName": "toa-spine-exporter",

    "files": [
      "**/*",
      "!assets/**/*" 
    ],

    "directories": {
      "output": "release"
    },

    "win": {
      "target": [
        {
          "target": "zip",
          "arch": "x64"
        }
      ],
      "artifactName": "toa-spine-exporter-${version}-win-${arch}.${ext}"
    },

    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        }
      ],
      "category": "Graphics",
      "executableName": "toa-spine-exporter",
      "artifactName": "toa-spine-exporter-${version}-linux-${arch}.${ext}"
    }
  },

  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.0.12"
  }
}

